# Block direct pushes to protected branches. Open a PR from a feature branch instead.
protected_ref="refs/heads/main"
while read -r local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "$protected_ref" ]; then
    echo "✗ Direct pushes to main are not allowed. Push a feature branch and open a PR against dev."
    exit 1
  fi
done

# Runs the same four checks CI runs (see .github/workflows/ci.yml → node job).
pnpm verify
