node_modules
dist
.turbo
.vitest-cache
coverage
*.tsbuildinfo
.pnpm-debug.log*

.env
.env.*
!.env.example

.terraform
# HashiCorp convention: commit .terraform.lock.hcl in root modules (the envs)
# but not in reusable modules — the calling root's pins are what matter.
.terraform.lock.hcl
!infra/environments/*/.terraform.lock.hcl
# docs/08-terraform-standards.md §Environment configuration: never commit
# real tfvars. Only *.example files are tracked.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example
*.tfstate
*.tfstate.*
*.tfplan
# Partial backend configuration — real bucket/key values (including AWS
# account IDs) live in backend.hcl next to each env's backend.tf. Only the
# .example templates are tracked (docs/09 §Open-source controls).
backend.hcl
!backend.hcl.example
crash.log
crash.*.log

# Credential material — belt-and-suspenders for docs/09 §Open-source controls.
*.pem
*.key
*.p12
*.pfx

# Slack CLI project state — created by `slack init`. Contains machine-local
# app IDs and per-user hooks. See docs/17-slack-app-setup.md §Path A.
.slack/

.DS_Store
.idea
.vscode
*.log
