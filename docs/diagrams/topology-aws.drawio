        <mxCell id="step-2-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Verify + open modal&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;slack-ingress verifies HMAC signature and replay window, ACKs 200, then opens the modal via views.open.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-2-legend">
