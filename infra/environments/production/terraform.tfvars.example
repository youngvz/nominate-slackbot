# Copy to terraform.tfvars and DO NOT commit the copy (docs/09 §Open-source controls).
# Never commit production values (docs/08 §Environment configuration).
aws_region             = "us-east-1"
project                = "nominate-slackbot"
environment            = "production"
recognition_channel_id = "C00000000"
maintainer_slack_ids   = []
# Required for the scheduled biweekly report — EventBridge invokes the Lambda
# with an empty payload and the target workspace is read from env
# (docs/10 §Scheduled input contract).
report_workspace_id = "T00000000"
artifact_bucket        = "example-artifacts-bucket"
owner                  = "team-recognition"
cost_center            = ""
data_classification    = "Internal"

# Production posture — stateful resources are protected.
enable_deletion_protection = true
force_destroy              = false
log_retention_days         = 30
